# Tokser Backup Manager — environment variables
# Copy to `.env` and edit. These override config.yaml.
# Never commit `.env` to version control.

# --- Application ---
TBM_ENV=production
TBM_DEBUG=false
TBM_HOST=127.0.0.1
TBM_PORT=8000

# --- Paths ---
# TBM_DATA_DIR=/opt/tokser-backup-manager/data
# TBM_BACKUP_DIR=/var/backups/tokser
# TBM_LOG_DIR=/opt/tokser-backup-manager/logs

# --- Database ---
# SQLite (default):
# TBM_DATABASE_URL=sqlite:////opt/tokser-backup-manager/data/tokser.db
# PostgreSQL:
# TBM_DATABASE_URL=postgresql+psycopg2://tbm:CHANGE_ME@localhost:5432/tokser

# --- Security ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
TBM_SECRET_KEY=
TBM_ENCRYPTION_KEY=
TBM_SESSION_TTL=12
TBM_SECURE_COOKIE=false
TBM_LOGIN_MAX_ATTEMPTS=5
TBM_LOGIN_LOCKOUT=15
TBM_RATE_LIMIT=120
# TBM_ALLOWED_HOSTS=backup.example.com
# TBM_TRUST_PROXY=true

# --- Backup engine ---
TBM_MAX_CONCURRENT=2
TBM_VERIFY=true
TBM_COMPRESSION=tar.gz
TBM_COMPRESSION_LEVEL=6
TBM_MIN_FREE_MB=512

# --- Telegram ---
# TBM_TELEGRAM_API=https://api.telegram.org
TBM_TELEGRAM_MAX_UPLOAD=51380224
TBM_TELEGRAM_RETRIES=3

# --- Scheduler ---
TBM_SCHEDULER=true
TBM_SCHEDULER_TICK=15
TBM_TIMEZONE=UTC

# --- UI ---
TBM_LANGUAGE=en
TBM_THEME=dark
