# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
config.yaml
!config.example.yaml
*.pem
*.key
*.crt
*.p12
*.pfx
.secret_key
.encryption_key

# ---------------------------------------------------------------------------
# User data — never commit real backups, databases or logs
# ---------------------------------------------------------------------------
data/
backups/
logs/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.tar
*.tar.gz
*.tgz
*.zip
*.zst
*.enc
!docs/screenshots/*.png

